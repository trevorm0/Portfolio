# Copy this file to .env and fill in the values.
#
# Formspree form ID — the part after /f/ in your form's endpoint,
# e.g. https://formspree.io/f/xyzabcde  ->  VITE_FORMSPREE_ID=xyzabcde
# This ID is a public identifier, not a secret, so it is safe in the browser.
# Leave empty and the contact form shows a "not connected" notice instead of
# pretending to send.
VITE_FORMSPREE_ID=
